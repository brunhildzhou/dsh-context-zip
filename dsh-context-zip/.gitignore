# Dependencies: installed on demand for build and type checking only.
node_modules/

# Build output of build.mjs. Regenerated by `npm run build`; never a source of truth.
lib/
engine/lib/
test/build/

# graphify's own output. Ignored so a later extraction does not ingest the graph
# into itself, and so the report and HTML stay out of the source tree.
graphify-out/

# 发布副本有意带上构建产物（别人拿到可直接安装），故不忽略它们
!lib/
!engine/lib/
!test/build/
